<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <_ProjectFileVersion>10.0.30319.1</_ProjectFileVersion>
    <FB_STATIC_PREPROCESSOR_DEFINITIONS>STATIC_CLIENT</FB_STATIC_PREPROCESSOR_DEFINITIONS>
    <FB_STATIC_PREPROCESSOR_DEFINITIONS Condition="'$(FBBUILD_WITHOUT_TOMCRYPT)'=='1'">STATIC_CLIENT;WITHOUT_TOMCRYPT</FB_STATIC_PREPROCESSOR_DEFINITIONS>
    <FbTomMathLib Condition="'$(FBBUILD_WITH_SYSTEM_TOMMATH)'!='1'">../../../extern/libtommath/lib/$(PlatformName)\Release\tommath.lib</FbTomMathLib>
    <FbTomCryptLib Condition="'$(FBBUILD_WITH_SYSTEM_TOMCRYPT)'!='1'">../../../extern/libtomcrypt/lib/$(PlatformName)\Release\tomcrypt.lib</FbTomCryptLib>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>$(FB_STATIC_PREPROCESSOR_DEFINITIONS);%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <AdditionalOptions>/Zo %(AdditionalOptions)</AdditionalOptions>
      <InlineFunctionExpansion>AnySuitable</InlineFunctionExpansion>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <FavorSizeOrSpeed>Speed</FavorSizeOrSpeed>
    </ClCompile>
    <ResourceCompile>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
  </ItemDefinitionGroup>
</Project>
